# ==============================================================================
# CRYPTO RISK PLATFORM - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Crypto Risk Platform"
APP_ENV=development                        # development | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── JWT Authentication ─────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-min-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL Database ────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto_risk_db
POSTGRES_USER=crypto_user
POSTGRES_PASSWORD=crypto_secret_pass
DATABASE_URL=postgresql+asyncpg://crypto_user:crypto_secret_pass@localhost:5432/crypto_risk_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_pass
REDIS_DB=0
REDIS_URL=redis://:redis_secret_pass@localhost:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:redis_secret_pass@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_secret_pass@localhost:6379/2

# ── CoinGecko API ─────────────────────────────────────────────────────────────
# Free tier: https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_coingecko_api_key_here
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# ── Binance API (Public endpoints - no key needed for market data) ─────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# ── Etherscan API ─────────────────────────────────────────────────────────────
# Free tier: https://etherscan.io/register
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ETHERSCAN_BASE_URL=https://api.etherscan.io/api

# ── Alchemy API (Blockchain node) ─────────────────────────────────────────────
# Free tier: https://www.alchemy.com
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_ETH_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here

# ── Twitter/X API ─────────────────────────────────────────────────────────────
# Free tier: https://developer.twitter.com
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# ── Reddit API ────────────────────────────────────────────────────────────────
# Free: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=CryptoRiskBot/1.0 by YourUsername

# ── DefiLlama API (No key required) ──────────────────────────────────────────
DEFILLAMA_BASE_URL=https://api.llama.fi

# ── CryptoCompare API ─────────────────────────────────────────────────────────
# Free tier: https://www.cryptocompare.com/cryptopian/api-keys
CRYPTOCOMPARE_API_KEY=your_cryptocompare_api_key_here

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Free: https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# ── ML Model Configuration ────────────────────────────────────────────────────
ML_MODEL_PATH=../ml_models
VECTOR_STORE_PATH=../vector_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_MODEL=microsoft/phi-2                  # phi-2 (CPU) | mistralai/Mistral-7B-Instruct-v0.3 (GPU)
LLM_DEVICE=cpu                             # cpu | cuda | mps

# ── Sentry (Error Monitoring) - Optional ──────────────────────────────────────
SENTRY_DSN=

# ── Telegram Bot (Alerts) - Optional ──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Data Collection Settings ──────────────────────────────────────────────────
DATA_COLLECTION_INTERVAL_SECONDS=60
PRICE_UPDATE_INTERVAL_SECONDS=10
SENTIMENT_UPDATE_INTERVAL_SECONDS=300
ONCHAIN_UPDATE_INTERVAL_SECONDS=120

# ── Risk Scoring Thresholds ───────────────────────────────────────────────────
RISK_LOW_THRESHOLD=30
RISK_MEDIUM_THRESHOLD=60
RISK_HIGH_THRESHOLD=80
ALERT_RISK_SPIKE_THRESHOLD=15             # Alert if risk changes by this % in 1hr

# ── Cache TTLs (seconds) ──────────────────────────────────────────────────────
CACHE_PRICE_TTL=10
CACHE_RISK_SCORE_TTL=60
CACHE_MARKET_DATA_TTL=300
CACHE_SENTIMENT_TTL=600
